#!/bin/bash
#
# Back up folders to the NAS as .tar.zst archives (one big stream per folder
# is far faster over SMB than copying thousands of small files).
#
# Usage: backup [-x pattern]... <label> <folder>...
#   Writes each folder to $DEST_ROOT/<yyyy-mon>-<label>/<name>.tar.zst,
#   named after the folder in lowercase, e.g. 2026-sep-mbp-m5/code.tar.zst.
#   -x adds an exclude pattern on top of the dependency folders below,
#   e.g. -x obsidian/backups.
#
# Restore: tar -xf <name>.tar.zst -C <folder's original parent>

set -euo pipefail

DEST_ROOT=/Volumes/backups-fred/backups

usage() { echo "usage: backup [-x pattern]... <label> <folder>..." >&2; exit 1; }

# Dependency, build and cache folders (matched at any depth)
EXCLUDES=(
  node_modules .venv venv __pycache__ .next .turbo dist build target
  .gradle Pods DerivedData .cache .pytest_cache .mypy_cache .ruff_cache
  coverage .DS_Store
)

while getopts "x:" opt; do
  case $opt in
    x) EXCLUDES+=("$OPTARG") ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -ge 2 ] || usage

LABEL=$1; shift
DEST="$DEST_ROOT/$(date +%Y-%b | tr '[:upper:]' '[:lower:]')-$LABEL"

# Resolve folders up front so a typo fails before anything is written
SOURCES=()
names=" "
for f in "$@"; do
  [ -d "$f" ] || { echo "not a folder: $f" >&2; exit 1; }
  path=$(cd "$f" && pwd)
  name=$(basename "$path" | tr '[:upper:]' '[:lower:]')
  case $names in *" $name "*) echo "two folders would both be $name.tar.zst" >&2; exit 1 ;; esac
  names+="$name "
  SOURCES+=("$name|$(dirname "$path")|$(basename "$path")")
done

command -v zstd >/dev/null || { echo "zstd not found (brew install zstd)" >&2; exit 1; }
[ -d "$DEST_ROOT" ] || { echo "$DEST_ROOT not mounted, connect to the NAS first" >&2; exit 1; }
mkdir -p "$DEST"
echo "Backing up to $DEST"

args=()
for e in "${EXCLUDES[@]}"; do args+=(--exclude "$e"); done

for entry in "${SOURCES[@]}"; do
  IFS='|' read -r name parent dir <<<"$entry"
  out="$DEST/$name.tar.zst"

  printf '%-10s ' "$name"
  start=$SECONDS
  # Write to a temp name and only replace an existing archive once verified
  tar -C "$parent" -cf - "${args[@]}" "$dir" | zstd -q -T0 -3 -o "$out.new"
  files=$(zstd -dc "$out.new" | tar -tf - | grep -vc '/$')
  mv -f "$out.new" "$out"
  echo "$(du -h "$out" | cut -f1 | tr -d ' ')  $files files  $((SECONDS - start))s"
done

echo "Done."
