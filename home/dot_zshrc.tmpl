export EDITOR="nvim"
export GOPATH="$HOME/.go"
export GOBIN="$HOME/.go/bin"
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$HOME/.bin:$HOME/.cargo/bin:$GOBIN:$PATH"
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# Aliases
alias g="git"
alias l="eza --icons"
alias ls="eza -l"
alias la="eza -la --icons"
alias cm="chezmoi"
alias buu="brew update && brew upgrade"
alias muu="mise upgrade"

{{ if not .is_snyk -}}
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
{{ end -}}

# Claude
alias ccc="claude --allow-dangerously-skip-permissions"

# History configuration
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt inc_append_history   # Write to the history file as commands run, not on shell exit
setopt share_history        # Share history across sessions
setopt hist_ignore_all_dups # Drop older duplicates of a repeated command
setopt hist_reduce_blanks   # Strip superfluous blanks
setopt hist_ignore_space    # Commands starting with a space stay out of history

# Other options
unsetopt extended_glob
unsetopt nomatch
setopt auto_param_slash
setopt mark_dirs
setopt list_types

# Completion
setopt auto_menu # Show a menu with completions
setopt always_to_end # Always move cursor to end of completion
setopt complete_in_word # Complete in middle of a word
unsetopt flow_control # Disables the use of ⌃S to stop terminal output and the use of ⌃Q to resume it
unsetopt menu_complete # If set, this option prevents the completion menu from showing even if AUTO_MENU is set
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[ -d "$ZSH_CACHE_DIR" ] || mkdir -p "$ZSH_CACHE_DIR"
zstyle ':completion:*:*:*:*:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z-_}={A-Za-z_-}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion::complete:*' use-cache 1
zstyle ':completion::complete:*' cache-path $ZSH_CACHE_DIR
zstyle ':completion:*' list-colors ''
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#) ([0-9a-z-]#)*=01;34=0=01'

# Antidote (static bundle, regenerated when .zsh_plugins.txt changes)
zsh_plugins=${ZDOTDIR:-$HOME}/.zsh_plugins.zsh
if [[ ! $zsh_plugins -nt ${ZDOTDIR:-$HOME}/.zsh_plugins.txt ]]; then
  source ${ZDOTDIR:-$HOME}/.antidote/antidote.zsh
  antidote bundle < ${ZDOTDIR:-$HOME}/.zsh_plugins.txt > $zsh_plugins
fi
source $zsh_plugins

# Completion init: after plugins, so their fpath additions get registered.
# Full rebuild when the dump is >24h old, otherwise trust the cache (-C).
autoload -Uz compinit
for _zcompdump in ${ZDOTDIR:-$HOME}/.zcompdump(N.mh+24); do
  compinit
done
compinit -C
unset _zcompdump

# History substring search (both normal and application-mode arrow sequences)
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^[OA' history-substring-search-up
bindkey '^[OB' history-substring-search-down

# FZF keybindings + completion
source <(fzf --zsh)

# Forgit
[ -f $HOMEBREW_PREFIX/share/forgit/forgit.plugin.zsh ] && source $HOMEBREW_PREFIX/share/forgit/forgit.plugin.zsh

# Initialize Zoxide
eval "$(zoxide init zsh)"

# Initialize mise
eval "$(mise activate zsh)"

# bun
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

{{ if not .is_snyk -}}
# atuin
eval "$(atuin init zsh --disable-up-arrow)"
{{ end -}}

# starship
eval "$(starship init zsh)"

{{ if not .is_snyk -}}
# Backup reminder: warn when `backup` hasn't run in 30+ days
_backup_last=${XDG_STATE_HOME:-$HOME/.local/state}/backup/last
if [[ ! -f $_backup_last ]]; then
  print -P "%F{yellow}⚠ No backup recorded on this machine. Run: backup <label>%f"
fi
for _backup_last in $_backup_last(N.md+30); do
  zmodload -F zsh/stat b:zstat; zmodload zsh/datetime
  print -P "%F{yellow}⚠ Last backup was $(( (EPOCHSECONDS - $(zstat +mtime $_backup_last)) / 86400 )) days ago. Run: backup $(<$_backup_last)%f"
done
unset _backup_last
{{ end -}}
