#!/bin/sh

set -eu

# Speed up Homebrew: skip per-invocation auto-update and download in parallel
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_DOWNLOAD_CONCURRENCY=auto

# Install homebrew if it doesn't exist yet (~/.zprofile, managed by chezmoi,
# picks it up for future shells; the eval covers this script and this bootstrap)
if [ ! -x /opt/homebrew/bin/brew ]; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

# Shared CLI packages
brew install \
  zsh \
  tmux \
  fzf \
  ripgrep \
  fd \
  eza \
  bat \
  jq \
  zstd \
  wget \
  btop \
  git \
  git-flow \
  git-lfs \
  forgit \
  mise \
  zoxide \
  gh \
  neovim \
  starship

{{ if not .is_snyk -}}
# Extras on personal devices
brew install \
  atuin \
  libyaml \
  syncthing \
  just \
  age \
  yt-dlp \
  fredoliveira/tap/recall

# Make sure syncthing is running (start is skipped when it already is, so
# package-list edits don't bounce the service)
brew services list | grep -qE "^syncthing\s+started" || brew services start syncthing
{{ end -}}

# Install casks
{{ if .install_casks -}}
brew install --cask \
  ghostty \
  1password \
  1password-cli \
  rectangle-pro \
  slack \
  zed

{{ if not .is_snyk -}}
# Personal-only casks
brew install --cask \
  firefox \
  spotify \
  fantastical \
  mimestream \
  obsidian \
  discord \
  alfred \
  keyboard-maestro \
  todoist-app \
  whatsapp \
  vlc \
  appcleaner \
  handy
{{ end -}}
{{ end -}}

# Desktop-specific packages (brew, casks, fonts, mas apps)
{{ if .is_desktop -}}
brew install --cask \
  linearmouse \
  betterdisplay
{{ end -}}

# Install fonts
brew install --cask font-iosevka-nerd-font font-iosevka-term-nerd-font

# Antidote for zsh
[ -d "${ZDOTDIR:-$HOME}/.antidote" ] || git clone --depth=1 https://github.com/mattmc3/antidote.git "${ZDOTDIR:-$HOME}/.antidote"

# Mac App Store apps (personal devices only; requires being signed in to the App Store)
{{ if not .is_snyk -}}
brew install mas
mas install 1435957248 # Drafts
mas install 1475387142 # Tailscale
mas install 1136220934 # Infuse
{{ end -}}

# Claude code setup
command -v claude >/dev/null 2>&1 || curl -fsSL https://claude.ai/install.sh | bash

echo ""
echo "============================================"
echo " Next steps:"
echo "============================================"
echo "  - If mas installs failed above: sign in to the App Store, then rerun them (mas install <id>)"
echo "  - Sign in to 1Password (desktop app)"
echo "  - Enable 1Password SSH agent in app settings"
echo "  - Run: gh auth login"
echo "  - Run: claude /login"
echo "  - Run: atuin login && atuin sync"
echo "  - Set up Syncthing pairing if needed"
echo "  - Restart terminal for PATH changes to take effect"
echo "============================================"
